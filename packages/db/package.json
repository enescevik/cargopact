{
  "name": "@cargopact/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude src/dsql.integration.test.ts",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:grant": "tsx src/cli.ts grant",
    "seed": "tsx src/cli.ts seed",
    "seed:demo": "tsx src/cli.ts seed-demo",
    "seed:verify": "tsx src/cli.ts seed-verify",
    "seed:reset": "tsx src/cli.ts seed-reset",
    "seed:users": "tsx src/cli.ts seed-users",
    "cleanup:smoke": "tsx src/cli.ts cleanup-smoke",
    "test:integration": "vitest run src/dsql.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/dsql-signer": "^3.700.0",
    "@cargopact/contracts": "*",
    "@cargopact/domain": "*",
    "pg": "^8.13.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
