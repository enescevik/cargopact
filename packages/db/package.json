    "seed:reset": "tsx src/cli.ts seed-reset",
    "seed:users": "tsx src/cli.ts seed-users"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/dsql-signer": "^3.700.0",
    "@cargopact/contracts": "*",
    "@cargopact/domain": "*",
    "pg": "^8.13.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": { "@types/pg": "^8.11.0", "@types/node": "^22.0.0", "tsx": "^4.19.0", "vitest": "^3.0.0", "typescript": "^5.6.0" }
