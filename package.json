{
  "name": "cargopact",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @cargopact/web",
    "dev:mobile": "npm run start -w @cargopact/mobile",
    "build:web": "npm run build -w @cargopact/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "synth": "npm run synth -w @cargopact/infra",
    "deploy": "npm run deploy -w @cargopact/infra",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @cargopact/db",
    "db:grant": "npm run db:grant -w @cargopact/db",
    "seed": "npm run seed -w @cargopact/db",
    "smoke": "NODE_PATH=packages/db/node_modules:node_modules tsx scripts/smoke-master-data.mjs; s=$?; npm run cleanup:smoke -w @cargopact/db; exit $s",
    "openapi": "npm run openapi -w @cargopact/contracts",
    "test:integration": "npm run test:integration -w @cargopact/db"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
